generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  login     String   @unique
  password  String
  version   Int      @default(1)
  createdAt Int
  updatedAt Int
}

model Artist {
  id     String  @id @default(uuid())
  name   String
  grammy Boolean

  albums Album[]
  tracks Track[]

  favoritedBy FavoritesArtist[]
}

model Album {
  id       String  @id @default(uuid())
  name     String
  year     Int
  artistId String?

  artist Artist? @relation(fields: [artistId], references: [id])
  tracks Track[]

  favoritedBy FavoritesAlbum[]
}

model Track {
  id       String  @id @default(uuid())
  name     String
  duration Int
  artistId String?
  albumId  String?

  artist Artist? @relation(fields: [artistId], references: [id])
  album  Album?  @relation(fields: [albumId], references: [id])

  favoritedBy FavoritesTrack[]
}

model Favorites {
  id String @id @default(uuid())

  artists FavoritesArtist[]
  albums  FavoritesAlbum[]
  tracks  FavoritesTrack[]
}

model FavoritesArtist {
  id          String @id @default(uuid())
  favoritesId String
  artistId    String

  favorites Favorites @relation(fields: [favoritesId], references: [id])
  artist    Artist    @relation(fields: [artistId], references: [id])
}

model FavoritesAlbum {
  id          String @id @default(uuid())
  favoritesId String
  albumId     String

  favorites Favorites @relation(fields: [favoritesId], references: [id])
  album     Album     @relation(fields: [albumId], references: [id])
}

model FavoritesTrack {
  id          String @id @default(uuid())
  favoritesId String
  trackId     String

  favorites Favorites @relation(fields: [favoritesId], references: [id])
  track     Track     @relation(fields: [trackId], references: [id])
}
